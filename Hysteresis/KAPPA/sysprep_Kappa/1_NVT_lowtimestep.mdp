; RUN CONTROL PARAMETERS
constraints              = h-bonds; all-bonds ; none
integrator               = md
dt                       = 0.0005
nsteps                   = 20000 ; 10 ps 
energy_grps              = Ion
freezegrps               = Electrode
freezedim                = Y Y Y

; OUTPUT CONTROL OPTIONS
nstcalclr                = 1
nstcomm                  = 1000
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 1000
nstenergy                = 1000
nstxtcout                = 1000

; NEIGHBORSEARCHING PARAMETERS
cutoff-scheme            = Verlet
nstlist                  = 40
ns_type                  = grid  
pbc                      = xy
periodic_molecules       = no
vdw-modifier             = Potential-shift

; OPTIONS FOR ELECTROSTATICS AND VDW
coulombtype              = PME
rcoulomb                 = 1.92
rvdw                     = 1.92
fourierspacing           = 0.12
pme_order                = 4
ewald_rtol               = 1e-05
ewald_geometry           = 3dc
table-extension          = 3
optimize_fft             = yes
epsilon_r                = 1.6;

; wallswalls
nwall                    = 2
wall-atomtype            = WA WA
wall-type                = 12-6
wall-ewald-zfac          = 3
wall-density             = 10 10


; OPTIONS FOR WEAK COUPLING ALGORITHMS
tcoupl                   = v-rescale
tc-grps	                 = System
tau_t                    = 0.5
ref_t                    = 100
Pcoupl                   = no
Pcoupltype               = isotropic
tau_p                    = 1
compressibility          = 0
ref_p                    = 1.0

; GENERATE VELOCITIES FOR STARTUP RUN
gen_vel                  = no
gen_temp                 = 100
gen_seed                 = 473529
